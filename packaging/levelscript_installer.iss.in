; LevelScript - Inno Setup template. Rendered by build_installer.py:
; @TOKEN@ markers are replaced before ISCC runs.

#define AppName        "@APP_NAME@"
#define AppVersion     "@APP_VERSION@"
#define AppPublisher   "@PUBLISHER@"
#define BundleDir      "@BUNDLE_DIR@"

[Setup]
; AppId MUST stay constant across versions so upgrades replace in place.
AppId={{@APP_ID@}
AppName={#AppName}
AppVersion={#AppVersion}
AppPublisher={#AppPublisher}
VersionInfoVersion={#AppVersion}

; Per-user install: no admin prompt, no UAC, no Program Files.
PrivilegesRequired=lowest
DefaultDirName={localappdata}\Programs\LevelScript
DisableProgramGroupPage=yes

ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible

; Broadcast WM_SETTINGCHANGE after install/uninstall so new shells see PATH.
ChangesEnvironment=yes

OutputDir=@OUTPUT_DIR@
OutputBaseFilename=@OUTPUT_BASENAME@
UninstallDisplayName={#AppName} {#AppVersion}
UninstallDisplayIcon={app}\bin\levelscript-debugger.exe
Compression=lzma2
SolidCompression=yes
WizardStyle=modern

[Files]
; bin\levelscript.exe, bin\levelscript-debugger.exe, bin\resources\ (fonts the
; debugger loads relative to its exe), examples\.
Source: "{#BundleDir}\*"; DestDir: "{app}"; Flags: recursesubdirs createallsubdirs ignoreversion

[Icons]
Name: "{userprograms}\LevelScript Debugger"; Filename: "{app}\bin\levelscript-debugger.exe"; \
    Comment: "Step through LevelScript programs"

[Code]
const
  EnvKey = 'Environment';

function PathDir: string;
begin
  Result := ExpandConstant('{app}\bin');
end;

procedure EnvAddPath(Path: string);
var
  Existing: string;
begin
  if not RegQueryStringValue(HKEY_CURRENT_USER, EnvKey, 'Path', Existing) then
    Existing := '';

  { Already present? compare case-insensitively, bounded by semicolons. }
  if Pos(';' + Uppercase(Path) + ';', ';' + Uppercase(Existing) + ';') > 0 then
    exit;

  if Existing = '' then
    Existing := Path
  else if Existing[Length(Existing)] = ';' then
    Existing := Existing + Path
  else
    Existing := Existing + ';' + Path;

  { REG_EXPAND_SZ so other %VARS% already in the user PATH still expand. }
  if RegWriteExpandStringValue(HKEY_CURRENT_USER, EnvKey, 'Path', Existing) then
    Log('Added to user PATH: ' + Path)
  else
    Log('FAILED to add to user PATH: ' + Path);
end;

procedure EnvRemovePath(Path: string);
var
  Existing: string;
  P: Integer;
begin
  if not RegQueryStringValue(HKEY_CURRENT_USER, EnvKey, 'Path', Existing) then
    exit;

  P := Pos(';' + Uppercase(Path) + ';', ';' + Uppercase(Existing) + ';');
  if P = 0 then exit;

  { P indexes into the ';'-padded copy; remove "Path;" or ";Path". }
  Delete(Existing, P - 1, Length(Path) + 1);

  if RegWriteExpandStringValue(HKEY_CURRENT_USER, EnvKey, 'Path', Existing) then
    Log('Removed from user PATH: ' + Path)
  else
    Log('FAILED to remove from user PATH: ' + Path);
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssPostInstall then
    EnvAddPath(PathDir);
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep = usPostUninstall then
    EnvRemovePath(PathDir);
end;
