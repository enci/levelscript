// @seed=12
// Step 9 - priority. An 'ordered' rule body tries its sub-rules in order: a
// later one is used only where no earlier one applies. The dungeon gets a
// few wide double doors first, and plain doors after that.
// @expect grid level count(door) >= 16

tag geometry {
    wall
    floor
    door
}

layers {
    zones: grid of number     // @view=border
    level: grid of geometry   // @view=fill
}

rule wall_between(rotation=90) {
    zones[?a ?b]
    when (a != b)
    =>
    level[* wall]
}

rule fill_floor { level[.] => level[floor] }
rule fill_wall  { level[.] => level[wall] }

// The first sub-rule makes a double door, the second a single one. The guard
// on the first reads the whole level: 'count(level[door])' is the number of
// door cells so far, so double doors stop after three of them.
//
// Under a step mode ('once', 'grow') every step collects the matches again
// and takes one from the highest sub-rule that has any. So the doors start
// out double, and turn single once the guard stops the first sub-rule.
rule doorway(rotation=90) { ordered
    level[
        *     wall  *
        floor wall  floor
        floor wall  floor
        *     wall  * ]
    zones[
        *  *  *
        ?a *  ?b
        ?a *  ?b
        *  *  * ]
    when (a != b && count(level[door]) < 6)
    =>
    level[
        * *    *
        * door *
        * door *
        * *    * ]

    level[
        *     wall  *
        floor wall  floor
        *     wall  * ]
    zones[
        *  *  *
        ?a *  ?b
        *  *  * ]
    when (a != b)
    =>
    level[
        * *    *
        * door *
        * *    * ]
}

// Under a batch mode ('scatter', 'everywhere') all matches come from one
// snapshot. 'ordered' then sorts them: the first sub-rule's matches claim
// their cells first, the next fill what is left. The guard is checked against
// the snapshot too, so it would not stop the double doors part way.
sequence main {
    resize(40, 30)
    bsp(into=zones, min=5, max=12)
    everywhere wall_between
    everywhere fill_floor
    pad(1)
    everywhere fill_wall            // @hold=10
    grow(16) doorway                // @speed=1
}

// Exercise: swap the two sub-rules and run again: the single door is always
// available, so no double door is ever made. Then try 'scatter(16) doorway'
// with the original order, and count the double doors.
