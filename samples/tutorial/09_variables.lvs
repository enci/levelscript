// @seed=9
// Step 9 - pattern variables. `?a` in a pattern captures whatever value the
// cell holds, so a rule can say "two neighbouring cells of different zones"
// without naming any zone. Walls go between the zones, and doors into the
// walls they share.
// @expect grid level count(door) >= 8
// @expect grid level count(floor) >= 400

tag geometry {
    wall
    floor
    door
}

layers {
    zones: grid of number     // @view=border
    level: grid of geometry   // @view=fill
}

// `?a` and `?b` bind the zone ids of two neighbouring cells. A binding cell
// never matches an empty cell. The guard `when (a != b)` is checked once per
// match, after the cells: the rule matches where two different zones meet.
// `rotation=90` adds the vertical version, so walls run both ways.
rule wall_between(rotation=90) {
    zones[?a ?b]
    when (a != b)
    =>
    level[* wall]
}

// Matching runs in two phases. First the plain cells: tags, `.`, `*`, and the
// binding cells, which also check that every cell of one variable holds the
// same value. Then the expression cells and guards, with every variable bound.
// So the order in which variables appear never matters.
//
// A door is a wall cell with floor on two opposite sides that lie in different
// zones, and wall on the two other sides, so a door never opens into a corner.
rule door(rotation=90) {
    level[
        *     wall  *
        floor wall  floor
        *     wall  * ]
    zones[
        *  *  *
        ?a *  ?b
        *  *  * ]
    when (a != b)
    =>
    level[
        * *    *
        * door *
        * *    * ]
}

rule fill_floor { level[.] => level[floor] }
rule fill_wall  { level[.] => level[wall] }

sequence main {
    resize(40, 30)
    bsp(into=zones, min=5, max=12)  // @hold=10
    everywhere wall_between         // @hold=10
    everywhere fill_floor
    pad(1)                          // an empty ring around every grid
    everywhere fill_wall            // @hold=10
    scatter(16) door
}

// Exercise: write a rule `fall` that drops loose rocks. Add `rock` to
// `geometry`, scatter a few rocks over the floor, and move each rock down into
// an empty floor below it: match `level[?r, floor]` and write `level[floor, (r)]`.
// Apply it with `settle` (step 11) or `grow` until nothing falls any more.
