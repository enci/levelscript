// @seed=6
// Step 6 - partitions. A 'grid of number' holds integers instead of tag
// values. 'bsp' splits the map into rectangles and numbers them, and rules
// match those numbers like any other cell value.
// @expect grid zones count(.) == 0
// @expect grid level count(floor) >= 36

tag geometry {
    wall
    floor
}

// A number grid starts empty like any other, and empty is not '0': '0' is a
// value a cell may store. '.' still matches an empty cell.
layers {
    zones: grid of number     // @view=border
    level: grid of geometry   // @view=fill
}

// A number in a pattern matches a cell storing that number. 'bsp' numbers its
// rectangles from 0 in reading order, so zone 0 is always the top-left one.
rule open_zone_zero {
    zones[0]
    =>
    level[floor]
}

// '!.' matches any stored number, '0' included.
rule fill_rest {
    zones[!.]
    level[.]
    =>
    level[wall]
}

// Operations are the built-in statements that are not rules. 'bsp' takes
// named arguments: the grid to write into, and the smallest and largest side
// a rectangle may have. Every cell of 'zones' gets the id of its rectangle.
sequence main {
    resize(40, 30)
    bsp(into=zones, min=6, max=14)      // @hold=20
    everywhere open_zone_zero           // @hold=10
    everywhere fill_rest
}

// Exercise: 'voronoi' is the other partition. Scatter a few sites first, then
// partition around them:
//
//     tag marks { site }                  and a layer  marks: grid of marks
//     scatter(8) { marks[.] => marks[site] }
//     voronoi(sites=site, into=zones)
//
// Replace the 'bsp' line with those two statements and compare the zones.
