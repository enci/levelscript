// Step 8 - cellular automata.

// 'settle' repeats a batch until a pass changes
// nothing, and a 'sequence' groups statements so they can be repeated
// together. A cave room is filled with noise and smoothed by two rules taking
// turns until the shapes stop changing.

tag fill {
    left
    right
    block
}

tag terrain {    
    river    
    marsh
    grass
    tree
    flower
    rock
}

layers {
    fill: grid of fill          // @view=fill
    terrain: grid of terrain    // @view=fill
}

sequence fill_lr {
    once(rotation=all) { fill[left . ]  => fill[left left] }
    once(rotation=all) { fill[right . ] => fill[right right] }
}

rule block {
    fill[. ]
    => fill[
    .     block block. 
    block block block block
    block block block block
    .     block block.]

}

sequence place_river {
    settle (rotation=all) { fill[left right] => terrain[river river] }
    settle (rotation=all) { terrain[river river rock] => terrain[river river river] }
    // settle (rotation=all, symmetry=all) {
    //     terrain[
    //         river .
    //         !rock rock]
    //     =>
    //     terrain[
    //         river river
    //         river rock
    //     ]
    // }
}

rule place_marsh (rotation=all) { ordered
    terrain[river .] => terrain[river marsh]
    terrain[marsh .] => terrain[marsh marsh]
}

sequence main {    
    resize(40, 30)
    scatter(4) block
    once { fill[.] where[(x < 20 )] => fill[left] }     // @hold=20
    once { fill[.] where[(x >= 20)] => fill[right] }    // @hold=20
    settle fill_lr
    everywhere { fill[block] => terrain[rock] }
    settle place_river
    //settle (rotation=all) { terrain[river river rock] => terrain[river river rock] }
    grow((width*height)/4) place_marsh
    everywhere { terrain[.] => terrain[grass] }
    scatter((width*height)/12) { terrain[grass] => terrain[tree] }
    scatter(5%) { terrain[marsh] => terrain[flower] }
}
