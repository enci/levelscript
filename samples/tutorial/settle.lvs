// Step 8 - cellular automata.

// 'settle' repeats a batch until a pass changes
// nothing, and a 'sequence' groups statements so they can be repeated
// together. A cave room is filled with noise and smoothed by two rules taking
// turns until the shapes stop changing.

tag fill {
    left
    right
}

tag terrain {    
    river    // @color=#3579ff
    marsh    // @color=#00b525
    grass    // @color=#008310
    tree     // @color=#00590b
    flower   // @color=#cf51fa
// color is directive  ^- the extension should place a color picker here
}

layers {
    fill: grid of fill          // @view=fill
    terrain: grid of terrain    // @view=fill
}

// When this sequence is run, it will fill the left and right halves of the
// map with, taking turns until the rule can not longer be applied.
sequence fill_lr {
    once(rotation=all) { fill[left . ]  => fill[left left] }
    once(rotation=all) { fill[right . ] => fill[right right] }
}


// Where the left and right halves meet, a river is placed.
// "Statistically" in the middle-ish of the screen :)
rule place_river (rotation=all) {
    fill[left right] => terrain[river river]
}

// We will grow marsh around the river
rule place_marsh (rotation=all) { ordered
    terrain[river .] => terrain[river marsh]
    terrain[marsh .] => terrain[marsh marsh]
}

// This rule places flowers, with a higher chance (3:1) of placing on marsh.
// This is different from the examples where different weights were given
// to different writes for the same match.
rule place_flower { any
    (weight=3) terrain[marsh] => terrain[flower]
    (weight=1) terrain[grass] => terrain[flower]
}

rule place_tree { any
    (weight=3) terrain[grass] => terrain[tree]
    terrain[marsh] => terrain[tree]
//  ^- the (weight=1) is implicit here
}


sequence main {    
    resize(40, 30)
    once { fill[.] where[(x < 20 )] => fill[left] }     // @hold=20
    once { fill[.] where[(x >= 20)] => fill[right] }    // @hold=20
    settle fill_lr                                      // @speed=10
    settle place_river
    grow((width*height)/4) place_marsh                  // @speed=2
    everywhere { terrain[.] => terrain[grass] }
    scatter(5%) place_tree
    scatter(5%) place_flower
}
