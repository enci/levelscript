// Step 6 - pattern variables and when. '?a' in a pattern captures whatever
// value the cell holds, so a rule can say "two neighboring cells of different
// zones" without naming any zone. Walls go between the zones, and doors into
// the walls they share.
//
// A guard 'when (...)' is the other kind of condition. Where a 'where' cell is
// one condition per cell, reading the layers at its own position, a guard is
// one condition for the whole match. It has no cell of its own, so it cannot
// read a layer or 'x' and 'y'. It reads the rule's variables instead, which
// is how it relates cells to each other: 'when (a != b)'.

tag geometry {
    W   // @name=wall
    F   // @name=floor
    D   // @name=door
}

layers {
    zones: grid of number     // @view=border
    level: grid of geometry   // @view=fill
}

// '?a' and '?b' bind the zone ids of two neighboring cells. A binding cell
// never matches an empty cell. The guard 'when (a != b)' is checked once per
// match, after the cells: the rule matches where two different zones meet.
// 'rotation=90' adds the vertical version, so walls run both ways.
rule wall_between(rotation=90) {
    zones[?a ?b]
    when (a != b)
    =>
    level[* W ]
}

// Matching runs in two phases. First the plain cells: tags, '.', '*', and the
// binding cells, which also check that every cell of one variable holds the
// same value. Then the expression cells and guards, with every variable bound.
// So the order in which variables appear never matters.
//
// A door is a wall cell with F on two opposite sides that lie in different
// zones, and wall on the two other sides, so a door never opens into a corner.
rule door(rotation=90) {
    level[
        * W * 
        F W F 
        * W * ]
    zones[
        *  *  * 
        ?a *  ?b
        *  *  * ]
    when (a != b)
    =>
    level[
        * * * 
        * D * 
        * * * ]
}

rule fill_F { level[.] => level[F] }
rule fill_wall  { level[.] => level[W] }

sequence main {
    resize(40, 30)
    bsp(into=zones, min=5, max=12)  // @hold=10
    everywhere wall_between         // @hold=10
    everywhere fill_F
    pad(1)                          // an empty ring around every grid
    everywhere fill_wall            // @hold=10
    scatter(16) door
}