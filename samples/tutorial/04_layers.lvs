// Step 4 - multiple layers. The walk now only sketches the cave in an `algo`
// grid; a second grid, `level`, holds the result. A rule can match in one
// grid and write another.

// Only what is needed for carving
// Short names makes it easier to read bigger patterns
tag algo {							
	F								// @name=floor
    H								// @name=head
    //								   ^- names for the visualizer
}

// Geometry as a separate tag
tag geometry {
    floor
    wall
    rock
    moss
    solid = wall | rock
    // With the | operator we can combine tags, we can use this for comparison
    // Reads as wall or rock
}

tag entities {
    player
    bat
    rat
    spider
    enemy = bat | rat | spider
    // Named tags can also written to the grid as well
}

// Two different grid defined on different tags
layers {
	algo: grid of algo				// @view=corner
    level: grid of geometry			// @view=fill
    entities: grid of entities      // @view=shape
    //                                 ^- This is a directive
    // "Directives" and not part of the language, only tooling uses them 
}

// Reminder
// '.' is empty tile
// '*' will match any tile when used for matching (before the '=>')
// '*' will leave the old value of the tile when used for writing (after the '=>')
rule place_head {
    algo[ 	. . . 
    		. . . 
        	. . . ]
    =>
    algo[	* * * 
			* H * 
            * * * ]
}

rule walk(rotation=all) {
    algo[H * *] => algo[F H * ]
}

rule fill_level {
// You can combine tags in rules with '|' a well
	algo[F|H] => level[floor]
//  ^-reading algo       ^-writing into level
}

rule wall_side(rotation=all) {
    level[floor . ] => level[* wall]
}

rule wall_corner(rotation=all) {
    level[
        floor wall 
        wall  .    ]
    =>
    level[
    	* * 
    	* wall ]
}

// Grow moss on the north and west walls
rule grow_moss(rotation=270) {
//			   ^-rotate this grid 270 deg as well
    level[	wall
    		floor]
    =>
    level[	* 
    		moss]
}

rule spawn_enemies {
    level[!solid|!.] => entities[enemy] 
//        ^= with the '!' we can negate a tag,
//          reads as 'not solid and not empty'
}




sequence main {
    resize(40, 30)
    once place_head
    grow(200) walk              // @play=8 @hold=10
    everywhere fill_level	    // Bridge the layers with this rule
    everywhere wall_side        // @hold=10
    everywhere wall_corner      // @hold=10
    scatter(10%) spawn_enemies  // @hold=10
}