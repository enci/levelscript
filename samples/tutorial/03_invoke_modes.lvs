// Step 3 - batch application. 'everywhere' and 'scatter' collect every match
// from one snapshot of the grid and apply them in a random (shuffled) order.
// We will use this for the wall and the moss.

tag algo { floor head wall moss } // Using full names here

layers { algo: grid of algo }

// The comas let us place more rows in one row.
// Smaller footprint, but harder to read at a glance.
rule place_head {
    algo[. . ., . . ., . . . ]
    =>
    algo[* * *, * head * , * * * ]
}

// Same as in tutorial 2
rule walk(rotation=all) {
    algo[head * *] => algo[floor head * ]
}

// Next to floor, an empty cell becomes wall. Under 'everywhere' every match is
// collected first, against the grid as it was when the statement started, so a
// wall written in this pass never makes another wall match. One pass gives a
// wall one cell thick. ('rotation=all' covers the four sides; the diagonal
// rule below closes the corners.)
rule wall_side(rotation=all) {
    algo[floor .] => algo[* wall]
}

// This rule is made to run after wall_side, to close the corners
rule wall_corner(rotation=all) {
    algo[
        floor wall 
        wall  .    ]
    =>
    algo[
    	* * 
    	* wall ]
}


// Grow moss on the north and west walls
rule grow_moss(rotation=270) {
//			   ^-rotate this grid 270 deg as well
    algo[	wall
    		floor]
    =>
    algo[	* 
    		moss]
}


// 'everywhere' applies every match it can; 'scatter(N)' applies at most N of
// them, chosen at random from the same kind of pass.
sequence main {
    resize(40, 30)
    once place_head
    grow(200) walk          // @speed=8 @hold=10
    once { algo[head] => algo[floor] }	// we can also inline rules
    everywhere wall_side    // @hold=10
    everywhere wall_corner  // @hold=10
    scatter(15%) grow_moss	// In scatter we can also supply count but also
    						// percentage. This fill first match all and then place
                            // the first % percent (match is randomized anyhow)
}