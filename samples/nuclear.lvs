// Nuclear throne level script that tries to mimic the procedural generation style of the game
// It's a random walk style level generator, with 2:1 preference for straight paths and it
// places either rewards or enemies whenever a paths terminates.

tag algo {
    T  // @name=tail
    H  // @name=head
    W  // @name=wall
    F  // @name=floor
    R  // @name=reward
    E  // @name=enemy
    N  // @name=nothing
    S  // @name=start
}

// Everything in the algo grid 
layers {
    algo : grid of algo
    tiles : grid of number
}

params {
    min_length : number = 4
    max_length : number = 7
}

// The very start of the level
rule start {
    algo[
        . . . 
        . . . 
        . . . 
    ] => algo[
        . . . 
        . F . 
        . . . 
    ]
}

// Pick from the floor to start carving
rule seed(rotation=all) {
    algo[F F . ]  => algo[T H . ]
}

// Carve out the paths from the seed
// symmetry=all makes sure we can turn both left and right (relative)
// rotation=all makes sure we can match the pattern in all orientations
rule step(rotation=all, symmetry=all) { ordered
    // Carve out the paths from the seed in all directions
    // While 3:2 preferring to carve straight paths (in one rule)
    algo[
        T H . 
        * . * 
     ] => { any
        (weight=3) algo[
            F T H 
            * * * ]
        (weight=2) algo[
            F T * 
            * H * ]
    }

    // Fallback rule to continue carving straight paths
    algo[T H . ] => algo[F T H ]    
}

rule finish { all
    algo[H] => { any
        (weight=1) algo[R]
        (weight=2) algo[E]
    }
    algo[T] =>  algo[F]
}

sequence carve {
    once seed
    grow(random(min_length, max_length)) step
    everywhere finish
}

rule walls(rotation=all) { any
    algo[!W . ] => algo[* W]
    algo[
        !W * 
        *  . ] =>
    algo[
        * * 
        * W ]
}


///////////////////////////////////////////////////////////////////////////////
// Paint the tiles layer from the algo layer (tilemap_packed_f.png, 5x5 of 8x8).
// Walls are drawn as lines joining wall neighbours, so the tile is picked by
// which of the four sides (N E S W) are walls. Straight pieces come in two
// variants (5/7 vertical, 1/11 horizontal) for a bit of texture.
rule decorate { all
    // lone pillar
    algo[
        *    !W *
        !W W    !W
        *    !W * ] => tiles[* * *, * 13 *, * * *]
    // dead end, vertical
    algo[
        *    W    *
        !W W    !W
        *    !W * ] => { any tiles[* * *, * 5 *, * * *] tiles[* * *, * 7 *, * * *] }
    algo[
        *    !W *
        !W W    !W
        *    W    * ] => { any tiles[* * *, * 5 *, * * *] tiles[* * *, * 7 *, * * *] }
    // dead end, horizontal
    algo[
        *    !W *
        !W W    W 
        *    !W * ] => { any tiles[* * *, * 1 *, * * *] tiles[* * *, * 11 *, * * *] }
    algo[
        *    !W *
        W    W    !W
        *    !W * ] => { any tiles[* * *, * 1 *, * * *] tiles[* * *, * 11 *, * * *] }
    // straight runs
    algo[
        *    W    *
        !W W    !W
        *    W    * ] => { any tiles[* * *, * 5 *, * * *] tiles[* * *, * 7 *, * * *] }
    algo[
        *    !W *
        W    W    W 
        *    !W * ] => { any tiles[* * *, * 1 *, * * *] tiles[* * *, * 11 *, * * *] }
    // corners
    algo[
        *    !W *
        !W W    W 
        *    W    * ] => tiles[* * *, * 0 *, * * *]
    algo[
        *    !W *
        W    W    !W
        *    W    * ] => tiles[* * *, * 2 *, * * *]
    algo[
        *    W    *
        !W W    W 
        *    !W * ] => tiles[* * *, * 10 *, * * *]
    algo[
        *    W    *
        W    W    !W
        *    !W * ] => tiles[* * *, * 12 *, * * *]
    // tees
    algo[
        *    W    *
        !W W    W 
        *    W    * ] => tiles[* * *, * 3 *, * * *]
    algo[
        *    W    *
        W    W    !W
        *    W    * ] => tiles[* * *, * 4 *, * * *]
    algo[
        *    !W *
        W    W    W 
        *    W    * ] => tiles[* * *, * 8 *, * * *]
    algo[
        *    W    *
        W    W    W 
        *    !W * ] => tiles[* * *, * 9 *, * * *]
    // cross
    algo[
        *    W    *
        W    W    W 
        *    W    * ] => tiles[* * *, * 6 *, * * *]

    // Start tile
    algo[S] => tiles[25]

    // Floor is the sheet's blank tile, crates the yellow block,
    // enemies one of the four critters
    algo[F] => tiles[14]

    // Reward sprites
    algo[R] => { any
        (weight=3) tiles[33]
        (weight=1) tiles[31]
        (weight=1) tiles[35]
        (weight=1) tiles[36]
        (weight=1) tiles[38]
        (weight=1) tiles[39]
        (weight=1) tiles[40]
    }

    // Enemies
    algo[E] => { any
        tiles[27]
        tiles[28]
        tiles[29]
        tiles[30]
    }

    // Empty floor tile
    algo[N] => tiles[14]
}

///////////////////////////////////////////////////////////////////////////////
sequence main {
    resize(4, 4)    
    once start
    upscale(3, 3)
    pad(2)
    settle(10) carve
    trim()
    pad(2)    
    everywhere walls // @play=5
    once { algo[E] => algo[S] }
    everywhere { algo[.] => algo[N] } // @play=10
    everywhere decorate // @play=5
}

