// Spelunky level script that tries to mimic the procedural generation style of the game

tag algo {
    T  // @name=tile
    H  // @name=head
    W  // @name=wall
    F  // @name=floor
    R  // @name=reward
    E  // @name=enemy
    N  // @name=nothing
    S  // @name=start

    entrance
    exit
    active
}

// Everything in the algo grid 
layers {
    algo : grid of algo
    path : grid of number
    tiles : grid of number
}

///////////////////////////////////////////////////////////////////////////////
// Coarse carving
///////////////////////////////////////////////////////////////////////////////
rule pick_start {
    algo[.] where[(y == 0)]
    =>
    { all algo[H] path[1] }
}

rule carve (rotation={90, 180}) {
    { algo[H . ] path[?v .] } => { all algo[T H ] path[?v (?v + 1)] }   
}

///////////////////////////////////////////////////////////////////////////////
// Room carving
///////////////////////////////////////////////////////////////////////////////

rule mark_entrance (rotation=all, symmetry=all) {
    path[?v (?v+1)] => algo[entrance active]
}

rule grow_active {
    path[?v ?v]
    algo[active . ]
    =>
    algo[active active]
}

rule mark_exit (rotation=all, symmetry=all) {
    algo[active . ]
    path[?v (?v+1)]
    => algo[exit active]
}

sequence carve_room {
    once mark_entrance
    settle grow_active
    once mark_exit
}

///////////////////////////////////////////////////////////////////////////////
sequence main {
    resize(4, 4)    
    once pick_start
    settle carve
    upscale(5, 4)
}

