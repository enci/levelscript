// A level generator based on  Binary Space Partitioning (BSP)

tag level {
    F // @name=floor
    W // @name=wall
    D // @name=door
    O // @name=open
}

tag entities {
    S // @name=spawn
    E // @name=exit
    P // @name=player
    N // @name=enemy
    I // @name=item
}

tag room { start, exit, guard, hub }

layers {
    level: grid of level
    zones: grid of number
    map : graph of level(nodes=F, edges=D)
}

rule border(rotation=90) {
    zones[?a ?b] when(?b != ?a) => level[* W ]
}

rule create_door(rotation=all) {
    level[
        
        F W . 
        F W . 
        F W . 
    ] => level[
        F W F 
        F D F 
        F W F 
    ]
}

rule fill_room (rotation=all) { level[F . ] => level[F F] }

sequence expand_room {
    once create_door
    settle fill_room
}

sequence connect_rooms {
    once { level[.] => level[F] }
    settle fill_room
    settle expand_room
}

sequence remove_edge_room {
    once (rotation=all) { map[* ?n] level[. F ] when (degree(?n) == 1) => level[. O] }
    settle (rotation=all) { level[O F ] => level[O O] }
}

sequence clear_walls {
    once (rotation=90) { level[F D F ] => level[* O *] }
    settle (rotation=all) {
        level[
            F O F 
            F W F 
        ] =>
        level[
            F O F 
            F O F 
        ]
    }
    everywhere { level[O] => level[F] }
}

// Decorate
sequence main {
    resize(24, 16)
    bsp(into=zones, min=5, max=8)

    everywhere border       // @play=2
    settle connect_rooms    // @play=5
    
    pad(1)
    settle(2) remove_edge_room
    settle(2) clear_walls
    

    // scatter(2) create_door

    //everywhere { level[.] => level[W] }  // @play=10
    //everywhere { level[O] => level[.] }  // @play=100        
    //pad(5)
    //settle (rotation=90) { level[. W|D .] => level[. . . ] } // @play=1The 
}