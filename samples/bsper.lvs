// A level generator based on  Binary Space Partitioning (BSP)

tag level {
    F // @name=floor
    W // @name=wall
    D // @name=door
    O // @name=open
    S = W|D
}

tag entities {
    S // @name=spawn
    E // @name=exit
    P // @name=player
    N // @name=enemy
    I // @name=item
    D // @name=decoration
    V // @name=vegetation
    G // @name=grave
}

tag room { start, exit, boss, reward, hub, challenge }

params {
    min_room_size : number = 5
    max_room_size : number = 5
}

layers {
    level: grid of level
    zones: grid of number
    map : graph of level(nodes=F, edges=D)
    rooms: grid of room
    entities: grid of entities
}

rule border(rotation=90) {
    zones[?a ?b] when(?b != ?a) => level[* W ]
}

rule create_door(rotation=all) {
    level[
        
        F W . 
        F W . 
        F W . 
    ] => level[
        F W F 
        F D F 
        F W F 
    ]
}

rule fill_room (rotation=all) { level[F . ] => level[F F] }

sequence expand_room {
    once create_door
    settle fill_room
}

sequence connect_rooms {
    once { level[.] => level[F] }
    settle fill_room
    settle expand_room
}

rule clear_walls (rotation=all) { level[. W|D . ] => level[. . . ] }

sequence remove_edge_room {
    once (rotation=all) { map[* ?n] level[. F ] when (degree(?n) == 1) => level[. O] }
    settle (rotation=all) { level[O F ] => level[O O] }     // @play=3
    settle (rotation=all) { level[O ] => level[.] }         // @play=3
    settle clear_walls
}

sequence merge_rooms {
    once (rotation=all) {
        level[F D F ]                           // Find a door between rooms
        map[?a * ?b]                            // map the tiles of the target rooms to variables ?a and ?b
        when(size(?a) <= 36 && size(?b) <= 50)  // make sure both rooms are small enough to merge
        =>
        level[* O *]                            // O will create and "opening" in the next step
    }
    settle (rotation=all) {                     // Basic replacement rule applied using settle 
        level[                                  // acting as cellular automaton for merging rooms
            F O F 
            F W F ]
        => level[
            F O F 
            F O F ]
    }
    everywhere { level[O] => level[F] }         // Convert any remaining O (openings) to floor tiles
}

rule add_walls(rotation=all) { ordered
    level[
        F W 
        W . ]
    => level[
        F W 
        W W ]
    level[F . ] => level[F W ]
}

rule add_start {
    map {?n} when (degree(?n) == 1) => rooms(?n)[start]
}

rule add_end {
    map {?s ?e}
    when (degree(?e) == 1 && every(?e, rooms[.]) && farthest(?s, ?e))
    =>
    rooms(?e)[exit]
}

rule add_boss {
    map {?e -- ?b}
    when (every(?e, rooms[exit]))
    => rooms(?b)[boss]
}

rule add_reward {
    map {?n}
    when (degree(?n) == 1 && every(?n, rooms[.]))
    => rooms(?n)[reward]
}

rule add_hub {
    map {?n}
    when (degree(?n) >= 3 && every(?n, rooms[.]))
    => rooms(?n)[hub]
}

rule add_challenge {
    map {?n}
    when (every(?n, rooms[.]))
    => rooms(?n)[challenge]
}

rule place_player_and_entrance(rotation=all) {
    rooms(3,3)[start]
    entities(3, 3)[.]
    level[
        F F F 
        F F F 
        F F F ]
    => entities[
        * * * 
        S P * 
        * * * ] 
}

rule place_exit(rotation=all) {
    rooms(3,3)[exit]
    entities(3, 3)[.]
    level[
        F F F 
        F F F 
        F F F ]
    => entities[
        * * * 
        * E * 
        * * * ] 
}

rule place_pillars(rotation=all) { ordered
    rooms(7,5)[hub|challenge]
    level(7,5)[F]
    => level[
        * * * * * * * 
        * W * W * W * 
        * * * * * * * 
        * W * W * W * 
        * * * * * * * ]

    rooms(5,5)[hub|challenge]
    level(5,5)[F]
    => level[
        * * * * *  
        * W * W * 
        * * * * * 
        * W * W * 
        * * * * * ]


    rooms(7,3)[hub|challenge]
    level(7,3)[F]
    => level[
        * * * * * * * 
        * W * W * W * 
        * * * * * * * ]
}

rule place_items(rotation=all) { any
    entities(2, 2)[.]
    level[
        W W 
        W F ]
    => entities[
        * * 
        * I ]

    entities[. . ]
    level[W F ]
    => entities[* I ] 
}

rule place_enemies {
    entities[.]
    level[F]
    => entities[N ] 
}

rule place_vegetation {    
    entities[.] level[.] => entities[V ] 
}

sequence main {
    resize(24, 16)
    bsp(into=zones, min=min_room_size, max=max_room_size)

    everywhere border       // @play=2
    settle connect_rooms    // @play=5
    
    pad(1)
    settle(2) remove_edge_room
    settle(2) merge_rooms

    pad(5)
    settle add_walls            // @play=3
    everywhere (rotation=all) { level[. D ] => level[. W ] }

    once add_start              // @hold=10
    once add_hub                // @hold=10
    once add_end                // @hold=10
    once add_boss               // @hold=10
    settle add_reward           // @hold=10    
    everywhere add_challenge    // @hold=10

    once place_player_and_entrance
    once place_exit             // @hold=10
    once place_pillars          // @hold=10
    scatter(15%) place_items        
    scatter(12%) place_enemies
    scatter(20%) place_vegetation   // @play=20
}