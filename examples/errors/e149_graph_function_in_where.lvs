// E149 (0.10, check 53): graph functions are valid only in graph-pattern cells.
// @expect error
// @expect stderr-contains is a graph function
tag algo { R, H }
tag room { Start }
layers {
    level: grid of algo
    rooms: grid of room
    map:   graph of level(nodes=R, edges=H)
}
rule r { level[R] where[ (degree() == 1) ] => level[H] }
sequence main { resize(2, 2) everywhere r }
