// E150 (0.10, check 53): distance and neighbors take a selector, not an expression.
// @expect error
// @expect stderr-contains takes a selector
tag algo { R, H }
tag room { Start }
layers {
    level: grid of algo
    rooms: grid of room
    map:   graph of level(nodes=R, edges=H)
}
rule r { map[ (distance(Start) == 1) ] => level[H] }
sequence main { resize(2, 2) everywhere r }
