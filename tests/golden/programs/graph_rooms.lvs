// Showcase (v0.10.0, nodes as values since v0.14.0): a graph layer reads the
// room structure out of a grid.
//
// A lattice of 3x3 rooms gets random halls between neighbours. `map` sees
// each room as a node and each hall as an edge (section 4.3), so graph
// patterns (section 5.12) bind each cell's room as `?n`, and rule guards
// label whole rooms by their place in the dungeon: dead ends, one of them
// the start, the rooms next to it, and the hubs. A room the start cannot
// reach is far (2^30), never at distance 0.
//
// @seed=2
// @expect run-ok

tag algo { room, hall }
tag role { dead_end, start, guard, hub }

layers {
    level: grid of algo
    roles: grid of role
    map:   graph of level(nodes=room, edges=hall)
}

rule lattice { level[.] where[ (x - x / 4 * 4 < 3 && y - y / 4 * 4 < 3) ] => level[room] }
rule hall_across { level[.] where[ (x - x / 4 * 4 == 3 && y - y / 4 * 4 == 1) ] => level[hall] }
rule hall_down   { level[.] where[ (y - y / 4 * 4 == 3 && x - x / 4 * 4 == 1) ] => level[hall] }

rule dead_ends { map[?n] when (degree(?n) == 1) => roles[dead_end] }
rule pick_start { map[?n] when (degree(?n) == 1) => roles[start] }
rule spread_start { map[?n] when (distance(?n, roles[start]) == 0) => roles[start] }
rule guards { map[?n] roles[.] when (adjacent(?n, roles[start])) => roles[guard] }
rule hubs { map[?n] roles[.] when (degree(?n) >= 3) => roles[hub] }

sequence main {
    resize(15, 11)
    everywhere lattice
    scatter(70%) hall_across
    scatter(70%) hall_down
    everywhere dead_ends
    once pick_start
    everywhere spread_start
    everywhere guards
    everywhere hubs
}
