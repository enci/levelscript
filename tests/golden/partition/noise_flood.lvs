// Showcase (v0.11): `noise` - fixed-point gradient noise (section 6.13).
//
// Under the default `normalize=rank`, `elevation < 30` floods 30% of the cells
// for every seed and every scale: 0.3 * 32 * 32 = 307.2, so 307 or 308.
//
// @seed 11
// @expect run-ok

tag geo { land, water }
layers {
    level:     grid of geo
    elevation: grid of number
}
rule flood  { level[.] where[ (elevation < 30) ] => level[water] }
rule ground { level[.] => level[land] }
sequence main {
    resize(32, 32)
    noise(into=elevation, lo=0, hi=99, scale=16, octaves=3)
    everywhere flood
    everywhere ground
}
