// Showcase (v0.11): `voronoi` - a partition operation (section 6.12).
//
// Rules place the sites; `voronoi` claims every floor cell for its nearest
// site, measured through floor, and writes zone ids into `zones`. A wall with
// one gap makes distances geodesic: cells right of the wall belong to the
// sites that reach them through the gap.
//
// @seed 5
// @expect run-ok

tag geo  { floor, wall }
tag mark { site }
layers {
    level: grid of geo
    marks: grid of mark
    zones: grid of number
}
rule barrier    { where[ (x == 12 && y != 8) ] => level[wall] }
rule ground     { level[.] => level[floor] }
rule place_site { level[floor] marks[.] => marks[site] }
sequence main {
    resize(24, 16)
    everywhere barrier
    everywhere ground
    scatter(6) place_site
    voronoi(sites=site, within=floor, into=zones)
}
