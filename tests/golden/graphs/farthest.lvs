// Graph rules (v0.15.3, section 5.12): `farthest`.
//
// One corridor of nine one-cell rooms runs from the bottom left, up the left
// edge, along the top row, and down to the bottom middle; a separate pair of
// rooms on the right edge is cut off from it. Start is the second room of the
// top row. The corridor's two ends are both four rooms from Start, so they
// tie and `once` picks one of them; the pair's rooms are dead ends too, but
// unreachable from Start, so they are never farthest. Among all rooms (`u`
// omitted), the farthest from Start are the same two corridor ends, marked
// `far`.
//
// @seed=1
// @expect run-ok

tag algo { R, H }
tag room { Start, Exit }
tag mark { leaf, far }

layers {
    level: grid of algo
    rooms: grid of room
    marks: grid of mark
    ends:  grid of mark
    map:   graph of level(nodes=R, edges=H)
}

sequence main {
    resize(9, 5)
    once { level[* * * * * * * * *, * * * * * * * * *, * * * * * * * * *, * * * * * * * * *, * * * * * * * * *] =>
           level[R H R H R . . . ., H . . . H . . . ., R . . . R H R . R, H . . . . . H . H, R H R . . . R . R] }
    once { rooms[* * * * * * * * *, * * * * * * * * *, * * * * * * * * *, * * * * * * * * *, * * * * * * * * *] =>
           rooms[. . Start . . . . . ., . . . . . . . . ., . . . . . . . . ., . . . . . . . . ., . . . . . . . . .] }
    // the dead ends, then the one farthest from Start
    everywhere { map { ?n } when (degree(?n) == 1) => marks(?n)[leaf] }
    once { map { ?n } when (farthest(?n, rooms[Start], marks[leaf])) => rooms(?n)[Exit] }
    everywhere { map { ?n } when (farthest(?n, rooms[Start])) => ends(?n)[far] }
}
