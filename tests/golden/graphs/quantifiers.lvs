// Graph rules (v0.15.1, section 5.12): `some`, `every`, and `count`.
//
// Four rooms in a row. Lamps light some cells and items lie on others.
// `n.light is .` finds the fully dark rooms, `some` the rooms with
// any lamp, and `count` sorts rooms by how many items they hold. The last
// rule lights a whole dark room only if a lit neighbour holds at least
// two items: quantifiers and graph functions in one guard.
//
// @seed=1
// @expect run-ok

tag algo { R, H }
tag lamp { on }
tag loot { coin }
tag mark { dark, lit, rich }

layers {
    level: grid of algo
    light: grid of lamp
    items: grid of loot
    marks: grid of mark
    held:  grid of number
    map:   graph of level(nodes=R, edges=H)
}

sequence main {
    resize(11, 2)
    once { level[* * * * * * * * * * *, * * * * * * * * * * *] =>
           level[R R H R R H R R H R R, R R . R R . R R . R R] }
    once { light[* * * * * * * * * * *, * * * * * * * * * * *] =>
           light[on . . . . . on on . . ., . . . . . . on on . . .] }
    once { items[* * * * * * * * * * *, * * * * * * * * * * *] =>
           items[coin coin . . coin . . . . . ., coin . . . . . . . . . coin] }
    everywhere { map { ?n } => n.held = (count(n, items[coin])) }
    everywhere { map { ?n } when (n.light is .) => n.marks = dark }
    everywhere { map { ?n } when (n.light is on) => n.marks = lit }
    everywhere { map { ?n } when (some(n, light[on]) && !(n.light is on) && count(n, items[coin]) >= 2) => n.marks = rich }
    // a dark room next to a room with a lamp and two coins gets lit
    everywhere {
        map { ?d ?r -- ?d }
        when (d.light is . && some(r, light[on]) && count(r, items[coin]) >= 2)
        =>
        d.light = on
    }
}
