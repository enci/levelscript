// @seed 42
// Showcase: a `scatter` percentage.
//
// `scatter(P%)` applies P% of one batch's matches — ⌊P·total/100⌋,
// an *exact* fraction of the candidate set (unlike a per-cell `random` gate,
// which has variance; cf. random_scatter.lvs). Only `scatter` takes one, since
// one batch's applied set is the percentage's denominator.
//
// Here every cell is rock (100 matches), then exactly 40% are carved to floor.
//
// @expect run-ok
// @expect grid g count(f) == 40    // exactly 40% of 100 carved
// @expect grid g count(r) == 60

tag t { rock, floor }

layers {
    g: grid of t
}

rule solid { g[.] => g[rock] }
rule carve { g[rock] => g[floor] }

sequence main {
    resize(10, 10)
    everywhere solid
    scatter(40%) carve
}
