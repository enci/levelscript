// Draw site (v0.10.0, section 10.6 item 4): an ordered pass shuffles, then sorts.
//
// The shuffle orders candidates within each sub-rule; the stable sort puts
// sub-rule 0 first. scatter(4) keeps the first four that do not conflict.
//
// @seed 5
// @expect run-ok

tag t { a, b }
layers { g: grid of t }

rule claim { ordered
    g[. .] => g[a a]
    g[.] => g[b]
}

sequence main {
    resize(8, 3)
    scatter(4) claim
}
