(rule treasure_room
  (pair
    (match
      (graph plan
        (node n))
      (when (&& (== (attr n degree) 1) (> (call distance n (selector rooms Start)) 3))))
    (write
      (graph-write n rooms Treasure))))
(rule market_hub
  (pair
    (match
      (graph plan
        (node hub)
        (node a)
        (edge hub a)
        (edge hub b)
        (edge hub c))
      (when (is (attr hub rooms) Hall))
      (when (is (attr a rooms) (| Shop Inn)))
      (when (== (attr hub degree) 4))
      (when (!= b c)))
    (write
      (all
        (graph-write hub rooms Market)
        (any
          (graph-write a decor stall)
          (graph-write a decor (paren (call if (> (attr a size) 4) stall .))))))))
(rule numbered
  (body all)
  (pair
    (match
      (graph zones_graph
        (node z))
      (when (== (attr z zones) 3)))
    (write
      (graph-write z zones (paren (+ (attr z value) 1)))))
  (pair
    (match
      (graph plan
        (node n))
      (when (is (attr n rooms) (! Hall)))
      (when (< (attr n size) 9)))
    (write
      (graph-write n rooms Closet))))
