(use "schema.lvs")
(use "lib/rules.lvs")
(tag geo
  (value wall)
  (value door)
  (value floor)
  (union blocker wall door))
(layers
  (grid level geo)
  (grid tiles number)
  (graph whole tiles)
  (graph floors level (nodes floor))
  (graph map level (nodes (| floor door)) (edges (! blocker))))
(input difficulty 3)
(input rooms (call random 2 5))
(derived budget (* difficulty 10))
