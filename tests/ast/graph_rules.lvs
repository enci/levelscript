// Graph rules (5.13): a graph block of node variables and edges, then rule
// guards (attributes and region reads); the write side is graph writes `n.g = c`.
rule treasure_room {
    plan { ?n }
    when (n.degree == 1 && distance(n, rooms[Start]) > 3)
    =>
    n.rooms = Treasure
}
rule market_hub {
    plan {
        ?hub
        ?a
        ?hub -- ?a
        ?hub--?b, ?hub -- ?c
    } when (hub.rooms is Hall) when (a.rooms is Shop|Inn)
    when (hub.degree == 4)
    when (b != c)
    =>
    { all
        hub.rooms = Market
        { any a.decor = stall a.decor = (if(a.size > 4, stall, .)) }
    }
}
rule numbered { all
    zones_graph { ?z } when (z.zones == 3) => z.zones = (z.value + 1)
    plan { ?n } when (n.rooms is !Hall) when (n.size < 9) => n.rooms = Closet
}
