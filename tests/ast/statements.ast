(sequence modes
  (everywhere fill)
  (settle smooth)
  (once start)
  (grow (count 200) walk)
  (scatter (percent 50) carve)
  (grow walk)
  (settle (count 3) smooth)
  (scatter (count 7) carve))
(sequence counts
  (scatter (count (/ budget 10)) a)
  (scatter (percent density) a)
  (scatter (percent (* n 2)) a)
  (grow (count (call random 1 3)) a)
  (settle (count (- n 1)) a)
  (scatter (percent 50) a))
(sequence inline
  (everywhere
    (rule
      (pair
        (match
          (pattern g
            (row .)))
        (write
          (pattern g
            (row a))))))
  (once
    (rule
      (symmetry all)
      (pair
        (match
          (pattern g
            (row a .)))
        (write
          (pattern g
            (row * b))))))
  (grow
    (rule
      (rotation 90 180 270)
      (pair
        (match
          (pattern g
            (row a .)))
        (write
          (pattern g
            (row * a))))))
  (grow (count n)
    (rule
      (rotation 90 180 270)
      (pair
        (match
          (pattern g
            (row a .)))
        (write
          (pattern g
            (row * a))))))
  (settle (count 3)
    (rule
      (body all)
      (pair
        (match
          (pattern g
            (row a)))
        (write
          (pattern g
            (row b))))
      (pair
        (match
          (pattern g
            (row b)))
        (write
          (pattern g
            (row a))))))
  (scatter (percent 50)
    (rule
      (pair
        (match
          (pattern g
            (row a))
          (pattern h
            (row .)))
        (write
          (pattern h
            (row x))))))
  (everywhere fill))
(sequence guards
  (op resize (arg 4) (arg 4) (when (> difficulty 3)))
  (everywhere fill (when (== style 0))))
(sequence delimited
  (op resize (arg 4) (arg 4))
  (everywhere r)
  (once r)
  (op path (arg from a) (arg to a) (arg into g) (arg write a))
  (everywhere r (when (== 1 1))))
