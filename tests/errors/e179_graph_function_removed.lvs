// E179 (0.17, 5.12): the unary graph functions are node attributes.
// @expect error
// @expect stderr-contains read the node attribute n.degree
tag algo { R, H }
tag room { Hall, Inn }
tag loot { coin }
layers {
    level: grid of algo
    rooms: grid of room
    items: grid of loot
    depth: grid of number
    map:   graph of level(nodes=R, edges=H)
    plan:  graph of rooms
}
rule r { plan { ?n } when (degree(n) == 1) => n.rooms = Inn }
sequence main { resize(2, 2) everywhere r }
