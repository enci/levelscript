// E172 (0.17, check 61): `map.size` reads the node at the current cell; a rule
// guard has no cell, so it binds the node and reads n.size.
// @expect error
// @expect stderr-contains there is no cell here
tag algo { R, H }
tag room { Hall, Inn }
tag loot { coin }
layers {
    level: grid of algo
    rooms: grid of room
    items: grid of loot
    depth: grid of number
    map:   graph of level(nodes=R, edges=H)
    plan:  graph of rooms
}
rule r { level[R] when (map.size > 2) => level[H] }
sequence main { resize(2, 2) everywhere r }
