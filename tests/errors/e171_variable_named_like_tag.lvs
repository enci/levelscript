// E171 (0.17, check 60): a variable is read by its bare name, so it may not
// share one with a tag value it could be confused with.
// @expect error
// @expect stderr-contains named like a tag value 'coin'
tag algo { R, H }
tag room { Hall, Inn }
tag loot { coin }
layers {
    level: grid of algo
    rooms: grid of room
    items: grid of loot
    depth: grid of number
    map:   graph of level(nodes=R, edges=H)
    plan:  graph of rooms
}
rule r { items[?coin] => items[.] }
sequence main { resize(2, 2) everywhere r }
