// E144 (0.10, check 51): a graph is never written; write its source.
// @expect error
// @expect stderr-contains cannot be written
tag algo { R, H }
tag room { Start }
layers {
    level: grid of algo
    rooms: grid of room
    map:   graph of level(nodes=R, edges=H)
}
rule r { level[R] => map[ (degree() == 0) ] }
sequence main { resize(2, 2) everywhere r }
