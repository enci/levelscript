// E174 (0.17, check 61): a comparison takes one region read.
// @expect error
// @expect stderr-contains takes one region read
tag algo { R, H }
tag room { Hall, Inn }
tag loot { coin }
layers {
    level: grid of algo
    rooms: grid of room
    items: grid of loot
    depth: grid of number
    map:   graph of level(nodes=R, edges=H)
    plan:  graph of rooms
}
rule r { plan { ?a -- ?b } when (a.depth == b.depth) => a.items = coin }
sequence main { resize(2, 2) everywhere r }
