// E149 (0.14, check 53): a graph function takes a node first.
// @expect error
// @expect stderr-contains takes a node first
tag algo { R, H }
tag room { Start }
layers {
    level: grid of algo
    rooms: grid of room
    map:   graph of level(nodes=R, edges=H)
}
rule r { level[?t] where[ (degree(?t) == 1) ] => level[H] }
sequence main { resize(2, 2) everywhere r }
