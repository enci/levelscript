// E165 (0.15, check 57): a graph write writes a node's region; it is a write of a graph rule only.
// @expect error
// @expect stderr-contains is a write of a graph rule only
tag room { Hall, Inn }
layers {
    rooms: grid of room
    plan:  graph of rooms
}
rule r { plan[?n] => n.rooms = Inn }
sequence main { resize(2, 2) everywhere r }
