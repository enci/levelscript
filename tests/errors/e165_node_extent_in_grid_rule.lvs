// E165 (0.15, check 57): a node extent writes a node's region; only a graph rule has nodes to write.
// @expect error
// @expect stderr-contains appears only on the write side of a graph rule
tag room { Hall, Inn }
layers {
    rooms: grid of room
    plan:  graph of rooms
}
rule r { plan[?n] => rooms(?n)[Inn] }
sequence main { resize(2, 2) everywhere r }
