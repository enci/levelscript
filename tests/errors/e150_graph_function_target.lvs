// E150 (0.14, check 53): a target is a node or a selector.
// @expect error
// @expect stderr-contains is a node or a selector
tag algo { R, H }
tag room { Start }
layers {
    level: grid of algo
    rooms: grid of room
    map:   graph of level(nodes=R, edges=H)
}
rule r { map[?n] when (distance(?n, Start) == 1) => level[H] }
sequence main { resize(2, 2) everywhere r }
