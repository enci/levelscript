// E145 (0.10, check 51): a graph name is not a value.
// @expect error
// @expect stderr-contains cannot be read as a value
tag algo { R, H }
tag room { Start }
layers {
    level: grid of algo
    rooms: grid of room
    map:   graph of level(nodes=R, edges=H)
}
rule r { level[R] where[ (map == 1) ] => level[H] }
sequence main { resize(2, 2) everywhere r }
