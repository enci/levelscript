{
  "name": "levelscript-web-editor",
  "private": true,
  "description": "CodeMirror 6 editor for the LevelScript website, bundled to docs/js/cm-editor.js",
  "scripts": {
    "build": "esbuild src/editor.ts --bundle --minify --format=iife --target=es2020 --outfile=../docs/js/cm-editor.js",
    "watch": "esbuild src/editor.ts --bundle --format=iife --target=es2020 --sourcemap --outfile=../docs/js/cm-editor.js --watch",
    "check": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
