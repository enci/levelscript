{
  "name": "levelscript",
  "displayName": "LevelScript",
  "description": "Syntax highlighting, diagnostics, tag-value coloring, hover, go-to-definition, and completion for .ls files",
  "version": "0.8.1",
  "publisher": "BojanEndrovski",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/enci/levelscript.git",
    "directory": "extension"
  },
  "homepage": "https://github.com/enci/levelscript#readme",
  "bugs": {
    "url": "https://github.com/enci/levelscript/issues"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:levelscript"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "levelscript",
        "aliases": [
          "LevelScript",
          "ls"
        ],
        "extensions": [
          ".ls"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "levelscript",
        "scopeName": "source.levelscript",
        "path": "./syntaxes/levelscript.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "levelscript.run",
        "title": "LevelScript: Debug",
        "icon": "$(debug-alt)"
      },
      {
        "command": "levelscript.locateDebugger",
        "title": "LevelScript: Locate Debugger"
      }
    ],
    "configuration": {
      "title": "LevelScript",
      "properties": {
        "levelscript.debuggerPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Path to the native `levelscript-debugger` executable. Left empty, the extension searches PATH and the usual install locations and fills this in."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "levelscript.run",
          "when": "resourceLangId == levelscript",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "levelscript.run",
          "when": "resourceLangId == levelscript"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "build:wasm": "cd .. && emcmake cmake -B build/wasm -DCMAKE_BUILD_TYPE=Release && cmake --build build/wasm",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node scripts/check-examples.js && node scripts/check-completion.js",
    "gen-icon": "node scripts/gen-icon.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.2",
    "typescript": "^5.3.0"
  }
}
