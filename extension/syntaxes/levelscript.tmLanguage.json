{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "LevelScript",
  "scopeName": "source.levelscript",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#keyword" },
    { "include": "#pattern-body" },
    { "include": "#operator" },
    { "include": "#number" },
    { "include": "#identifier" }
  ],
  "repository": {
    "string": {
      "name": "string.quoted.double.levelscript",
      "match": "\"[^\"\\n]*\"?"
    },
    "comment": {
      "patterns": [
        { "include": "#directive-comment" },
        {
          "name": "comment.line.double-slash.levelscript",
          "match": "//.*$"
        }
      ]
    },
    "directive-comment": {
      "name": "comment.line.double-slash.directive.levelscript",
      "begin": "//(?=[ \\t]*@)",
      "end": "$",
      "patterns": [
        {
          "comment": "a text directive (@expect, @param): the text runs to a '//' note",
          "match": "(@)([A-Za-z_][A-Za-z0-9_]*)[ \\t]+((?:(?!//).)*?)(?=[ \\t]*(?://|$))",
          "captures": {
            "1": { "name": "punctuation.definition.annotation.levelscript" },
            "2": { "name": "storage.type.annotation.directive.levelscript" },
            "3": { "name": "string.unquoted.directive-text.levelscript" }
          }
        },
        {
          "match": "(@)([A-Za-z_][A-Za-z0-9_]*)(=)([A-Za-z_][A-Za-z0-9_]*|[0-9]+)",
          "captures": {
            "1": { "name": "punctuation.definition.annotation.levelscript" },
            "2": { "name": "storage.type.annotation.directive.levelscript" },
            "3": { "name": "keyword.operator.assignment.levelscript" },
            "4": { "name": "constant.other.directive-value.levelscript" }
          }
        }
      ]
    },
    "keyword": {
      "name": "keyword.control.levelscript",
      "match": "\\b(use|tag|layers|grid|graph|of|number|rule|sequence|params|where|when|any|all|ordered|once|scatter|everywhere|grow|settle|symmetry|rotation|weight|none|horizontal|vertical|nodes|edges)\\b"
    },
    "operator": {
      "name": "keyword.operator.levelscript",
      "match": "=>|==|!=|<=|>=|&&|\\|\\||[+\\-*/|!<>=%]"
    },
    "pattern-body": {
      "name": "meta.pattern.levelscript",
      "begin": "\\[",
      "end": "\\]",
      "beginCaptures": { "0": { "name": "punctuation.definition.pattern.begin.levelscript" } },
      "endCaptures":   { "0": { "name": "punctuation.definition.pattern.end.levelscript" } },
      "patterns": [
        { "include": "#comment" },
        { "include": "#wildcard" },
        { "include": "#variable" },
        { "include": "#builtin" },
        { "include": "#operator" },
        { "include": "#number" },
        { "include": "#identifier" }
      ]
    },
    "variable": {
      "name": "variable.other.pattern.levelscript",
      "match": "\\?[A-Za-z_][A-Za-z0-9_]*"
    },
    "builtin": {
      "name": "support.function.builtin.levelscript",
      "match": "\\b(if|min|max|abs|clamp|random|degree|size|distance|neighbors|resize|upscale|trim|mirror|pad|path|bsp|voronoi|noise)\\b(?=\\s*\\()"
    },
    "wildcard": {
      "patterns": [
        { "name": "constant.language.wildcard.any.levelscript",   "match": "\\*" },
        { "name": "constant.language.wildcard.empty.levelscript", "match": "\\." }
      ]
    },
    "number": {
      "name": "constant.numeric.levelscript",
      "match": "\\b[0-9]+\\b"
    },
    "identifier": {
      "name": "entity.name.levelscript",
      "match": "[\\w]+"
    }
  }
}
