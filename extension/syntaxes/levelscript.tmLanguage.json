{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "LevelScript",
  "scopeName": "source.levelscript",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#keyword" },
    { "include": "#pattern-body" },
    { "include": "#operator" },
    { "include": "#number" },
    { "include": "#identifier" }
  ],
  "repository": {
    "string": {
      "name": "string.quoted.double.levelscript",
      "match": "\"[^\"\\n]*\"?"
    },
    "comment": {
      "name": "comment.line.double-slash.levelscript",
      "match": "//.*$"
    },
    "keyword": {
      "name": "keyword.control.levelscript",
      "match": "\\b(use|tag|layers|grid|of|number|rule|sequence|params|where|when|any|all|ordered|once|scatter|everywhere|grow|settle|symmetry|rotation|weight|none|horizontal|vertical)\\b"
    },
    "operator": {
      "name": "keyword.operator.levelscript",
      "match": "=>|==|!=|<=|>=|&&|\\|\\||[+\\-*/|!<>=%]"
    },
    "pattern-body": {
      "name": "meta.pattern.levelscript",
      "begin": "\\[",
      "end": "\\]",
      "beginCaptures": { "0": { "name": "punctuation.definition.pattern.begin.levelscript" } },
      "endCaptures":   { "0": { "name": "punctuation.definition.pattern.end.levelscript" } },
      "patterns": [
        { "include": "#comment" },
        { "include": "#wildcard" },
        { "include": "#variable" },
        { "include": "#builtin" },
        { "include": "#operator" },
        { "include": "#number" },
        { "include": "#identifier" }
      ]
    },
    "variable": {
      "name": "variable.other.pattern.levelscript",
      "match": "\\?[A-Za-z_][A-Za-z0-9_]*"
    },
    "builtin": {
      "name": "support.function.builtin.levelscript",
      "match": "\\b(if|min|max|abs|clamp|random|resize|upscale|trim|mirror|pad|path)\\b(?=\\s*\\()"
    },
    "wildcard": {
      "patterns": [
        { "name": "constant.language.wildcard.any.levelscript",   "match": "\\*" },
        { "name": "constant.language.wildcard.empty.levelscript", "match": "\\." }
      ]
    },
    "number": {
      "name": "constant.numeric.levelscript",
      "match": "\\b[0-9]+\\b"
    },
    "identifier": {
      "name": "entity.name.levelscript",
      "match": "[\\w]+"
    }
  }
}
